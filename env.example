# HandySG app environment template. Key names only, no values.
#
# Copy the keys into:
#   .env.development  used by `npm start` / `npm run web` (expo start)
#   .env.production   used by `npx expo export` and EAS production builds
# Both files are git-ignored. Only src/config/env.ts reads these values.
#
# Everything prefixed EXPO_PUBLIC_ is baked into the app bundle in plain text,
# so it must never hold a secret (no API keys, no AUTH_SECRET).

# Base URL of the HandySG API, no trailing slash.
#   Web / iOS simulator:  http://localhost:<backend PORT>
#   Android emulator:     http://10.0.2.2:<backend PORT>
#   Physical phone:       http://<your Mac's LAN IP>:<backend PORT>
#   Production:           https://api.handysg.sg
EXPO_PUBLIC_API_URL=
